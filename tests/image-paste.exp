#!/usr/bin/expect -f
# image-paste.exp — drive image input under a pty, end to end: paste a path,
# attach it, send it to a real vision model, and read the answer back.
#
# The point of a live test here is that nothing else can prove it.  Unit
# tests show the block is built and the JSON is shaped right; only a real
# model looking at real bytes proves the bytes that left evo were the image
# the user attached.  So the assertion is semantic — the model must name the
# colour that fills the fixture — and it is worth the round trip.
set timeout 180

set repo [file dirname [file dirname [file normalize $argv0]]]
set scratch [exec mktemp -d /tmp/evo-image.XXXXXX]
set env(EVO_HOME) "$scratch/home"
file mkdir $env(EVO_HOME)
proc envdef {name default} {
    global env
    return [expr {[info exists env($name)] ? $env($name) : $default}]
}
set base_url [envdef EVO_TEST_BASE_URL ""]
set api_key  [envdef EVO_TEST_API_KEY  ""]
# A VISION model: EVO_TEST_MODEL is free to be text-only, and a text-only
# endpoint rejects image input outright (that is what :vision nil is for).
set model    [envdef EVO_TEST_VISION_MODEL ""]
if {$base_url eq "" || $api_key eq "" || $model eq ""} {
    puts stderr "image-paste.exp: set EVO_TEST_BASE_URL, EVO_TEST_API_KEY and EVO_TEST_VISION_MODEL (dev values in project memory)"
    exit 1
}
foreach v {EVO_SUPERVISED_CHILD EVO_HEARTBEAT_FILE} {
    if {[info exists env($v)]} { unset env($v) }
}
set f [open "$env(EVO_HOME)/init.lisp" w]
puts $f "(evo:register-model \"$model\" :provider :anthropic :api :anthropic-messages :context-window 1000000 :max-output 64000 :thinking t :vision t)"
puts $f "(evo:set-setting :model \"$model\")"
puts $f {(evo:set-setting :thinking :low)}
puts $f "(evo:register-provider :anthropic :base-url \"$base_url\" :api-key \"$api_key\")"
close $f

set workdir "$scratch/work"
file mkdir $workdir
cd $workdir

# The fixture: a 64x64 PNG filled with red (#dc1414), written byte for byte
# so the test has no image tooling dependency.
set png_hex ""
set png "$workdir/red-square.png"
set fh [open $png w]
fconfigure $fh -translation binary
puts -nonewline $fh [binary format H* $png_hex]
close $fh

set pass 0
set failures {}
proc check {name} {
    global pass
    incr pass
    puts "\nPASS: $name"
}
proc fail {name} {
    global failures
    lappend failures $name
    puts "\nFAIL: $name"
}

spawn "$repo/build/evo"

expect {
    -re {ctx \d+k/\d+k} { }
    timeout { fail "startup"; exit 1 }
}

# 1. Dropping a file onto a terminal arrives as a bracketed paste of its
#    path: it must attach, not type the path.
send "\x1b\[200~$png\x1b\[201~"
expect {
    -re {Image #1 attached} { check "pasted path attaches as Image #1" }
    timeout { fail "pasted path attaches as Image #1" }
}
expect {
    -re {\[Image #1\]} { check "attachment shows as a token in the editor" }
    timeout { fail "attachment shows as a token in the editor" }
}

# 2. The model must actually see it: ask a question only the pixels answer,
#    in a shape no stray word in a spinner or a thought can accidentally
#    match ("red" alone would also match "hundred", "required", ...).
send "What single colour fills this image? Reply with exactly one line: colour-is-<word>.\r"
expect {
    -nocase -re {colour-is-red} { check "vision model reads the pasted image" }
    -re {✗ provider error} { fail "vision model reads the pasted image" }
    timeout { fail "vision model reads the pasted image" }
}

# 3. The image is in the journal, by value: the session replays without the
#    original file.
expect {
    -re {○ idle} { }
    timeout { }
}
set session ""
for {set i 0} {$i < 40} {incr i} {
    catch {set session [exec sh -c "ls -t $env(EVO_HOME)/sessions/*/*.sexp 2>/dev/null | head -1"]}
    if {$session ne ""} break
    sleep 0.5
}
if {$session eq ""} { fail "session journal written"; exit 1 }
if {![catch {exec grep -q -- ":type :image" $session}]} {
    check "image block is journaled with the session"
} else {
    fail "image block is journaled with the session"
}
if {![catch {exec grep -q -- ":media-type \"image/png\"" $session}]} {
    check "journaled block carries its media type"
} else {
    fail "journaled block carries its media type"
}

# 4. /image is the other door to the same attach.
send "/image $png\r"
expect {
    -re {Image #2 attached} { check "/image attaches by path" }
    timeout { fail "/image attaches by path" }
}
send "\x03"
sleep 0.3

# 5. A bad path is a message, not a crash.
send "/image $workdir/not-here.png\r"
expect {
    -re {no such file} { check "/image reports a bad path" }
    timeout { fail "/image reports a bad path" }
}

# 6. The clipboard gestures, byte for byte as terminals send them.
#
# This is the half that broke in the field: ctrl+v did *nothing at all* —
# no attach, no message — because the key never reached the handler, and
# cmd+v (the paste gesture people actually use on macOS) was invisible.  So
# the assertion here is deliberately weak on outcome and strong on reaching
# the code: with an image on the pasteboard the gesture must attach, and
# without one it must say so.  Silence is the failure.
#
# On macOS the pasteboard is seeded for real (this DOES take over your
# clipboard while the test runs); elsewhere there is nothing to seed, and
# the "no image" message is the proof the gesture was heard.
set seeded 0
if {![catch {exec osascript -e "set the clipboard to (read (POSIX file \"$png\") as «class PNGf»)"}]} {
    set seeded 1
}
set heard {Image #\d+ attached}
# Without a pasteboard to seed, the proof is the answer: either the
# clipboard was read and held no image, or evo named the piece this
# session is missing (no wl-clipboard/xclip, no display at all, ...).
# Any of them means the keystroke arrived; none of them is silence.
if {!$seeded} {
    set heard {(no image on the clipboard|no clipboard tool|has no clipboard|unreachable)}
}

proc gesture {name bytes} {
    global heard
    send $bytes
    expect {
        -re $heard { check $name }
        timeout { fail $name }
    }
    send "\x03"
    sleep 0.3
}

# ctrl+v, in each of the three encodings a terminal may choose for it.  The
# last two are not hypothetical: evo asks for both protocols at startup.
gesture "ctrl+v (legacy C0 byte)"        "\x16"
gesture "ctrl+v (kitty CSI-u)"           "\x1b\[118;5u"
gesture "ctrl+v (modifyOtherKeys)"       "\x1b\[27;5;118~"
# ctrl+alt+v: the same request, for terminals that keep ctrl+v for their
# own paste (VS Code on Linux/Windows, Windows Terminal under WSL).  The
# legacy spelling is ESC then the control byte, which evo used to drop.
gesture "ctrl+alt+v (legacy ESC + C0)"   "\x1b\x16"
gesture "ctrl+alt+v (kitty CSI-u)"       "\x1b\[118;7u"
gesture "ctrl+alt+v (modifyOtherKeys)"   "\x1b\[27;7;118~"
# cmd+v / right-click Paste with an image on the clipboard: the terminal
# has no text to paste and sends an empty bracketed paste.  That is the
# whole gesture, and it must reach the clipboard.
gesture "cmd+v (empty bracketed paste)"  "\x1b\[200~\x1b\[201~"
# cmd+v reported as a key, by a terminal that forwards super.
gesture "cmd+v (kitty super modifier)"   "\x1b\[118;9u"

send "/quit\r"
expect eof

puts "\n$pass passed, [llength $failures] failed"
if {[llength $failures] > 0} {
    puts "failures: $failures"
    exit 1
}
exit 0

#!/usr/bin/expect -f
# tui.exp — drive the TUI under a pty: startup paint, /help, paste collapse,
# the /thinking ladder, a live model round-trip, todo panel, and /quit.
set timeout 180

set repo [file dirname [file dirname [file normalize $argv0]]]
set scratch [exec mktemp -d /tmp/evo-tui.XXXXXX]
set env(EVO_HOME) "$scratch/home"
file mkdir $env(EVO_HOME)
# Backend config comes from the environment (defaults for the local dev proxy).
proc envdef {name default} {
    global env
    return [expr {[info exists env($name)] ? $env($name) : $default}]
}
set base_url [envdef EVO_TEST_BASE_URL ""]
set api_key  [envdef EVO_TEST_API_KEY  ""]
set model    [envdef EVO_TEST_MODEL    ""]
# No backend/key/model is baked into the repo (dev values are in project
# memory, .evo/).  Without full config this live-model test can't run: fail
# hard rather than pass vacuously.
if {$base_url eq "" || $api_key eq "" || $model eq ""} {
    puts stderr "tui.exp: set EVO_TEST_BASE_URL, EVO_TEST_API_KEY and EVO_TEST_MODEL (dev values in project memory)"
    exit 1
}
# Don't inherit a parent supervisor's private env (e.g. when run from inside an
# agent): let the evo under test manage its own lifecycle and heartbeat.
foreach v {EVO_SUPERVISED_CHILD EVO_HEARTBEAT_FILE} {
    if {[info exists env($v)]} { unset env($v) }
}
set f [open "$env(EVO_HOME)/init.lisp" w]
puts $f "(evo:register-model \"$model\" :provider :anthropic :api :anthropic-messages :context-window 1000000 :max-output 64000)"
puts $f "(evo:set-setting :model \"$model\")"
puts $f {(evo:set-setting :thinking :xhigh)}
puts $f "(evo:register-provider :anthropic :base-url \"$base_url\" :api-key \"$api_key\")"
close $f

set workdir "$scratch/work"
file mkdir $workdir
cd $workdir

set pass 0
set failures {}
proc check {name} {
    global pass
    incr pass
    puts "\nPASS: $name"
}
proc fail {name} {
    global failures
    lappend failures $name
    puts "\nFAIL: $name"
}

spawn "$repo/build/evo"

# 1. the region paints on startup: status line with live context usage
expect {
    -re {ctx \d+k/\d+k} { check "startup status line" }
    timeout { fail "startup status line"; exit 1 }
}

# 2. /help lists commands
send "/help\r"
expect {
    -re {/tree} { check "/help output" }
    timeout { fail "/help output" }
}

# 3. paste collapse: 5-line bracketed paste becomes a placeholder
send "\x1b\[200~alpha\nbravo\ncharlie\ndelta\necho\x1b\[201~"
expect {
    -re {\[paste #1: 5 lines\]} { check "paste collapse placeholder" }
    timeout { fail "paste collapse placeholder" }
}
# clear the editor
send "\x03"
sleep 0.3

# 4. /thinking: the ladder has no off rung, and a real rung reaches the
# status line.  init.lisp above sets :xhigh, so "max" in the status line can
# only come from the command (xhigh contains "high", not "max").
send "/thinking off\r"
expect {
    -re {levels: low medium high xhigh max} { check "/thinking off is refused" }
    timeout { fail "/thinking off is refused" }
}
send "/thinking max\r"
expect {
    -re {max.*ctx \d+k} { check "/thinking max reaches the status line" }
    timeout { fail "/thinking max reaches the status line" }
}

# 5. live round trip through the model
send "Reply with exactly the word: tui-marker-747\r"
expect {
    -re {tui-marker-747} {
        # first match may be our own echo line; wait for the model's reply
        expect {
            -re {tui-marker-747} { check "model round-trip" }
            timeout { fail "model round-trip" }
        }
    }
    timeout { fail "model round-trip" }
}

# 6. todo tool drives the panel
send "Use the todo tool to create a two-item checklist: first item 'demo-item-one' pending, second 'demo-item-two' in-progress. Then say done.\r"
expect {
    -re {demo-item-one} { check "todo panel renders" }
    timeout { fail "todo panel renders" }
}
# wait for the run to settle
expect {
    -re {done|Done} {}
    timeout {}
}

# 7. quit cleanly
send "/quit\r"
expect {
    eof { check "clean quit" }
    timeout { fail "clean quit"; catch {close} }
}

puts "\n$pass checks passed, [llength $failures] failed ($scratch)"
if {[llength $failures] > 0} { exit 1 }
exit 0

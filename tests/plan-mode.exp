#!/usr/bin/expect -f
# plan-mode.exp — e2e wiring of plan mode in the TUI:
# shift+tab toggles, /permission switches, and the journal records the mode state
# and tool gating.  Plan mode is a core extension, so the evo home here has
# an EMPTY extensions directory on purpose: everything under test has to
# come out of the binary.  (The gate itself is unit-tested — model behavior
# under plan instructions is nondeterministic.)
#
# STYLE, NOT TASTE: every `expect` below opens its brace and then puts each
# pattern on its OWN line.  Written as a one-liner —
#     expect { -re {foo} { check ... } timeout { fail ... } }
# — expect 5.45 (the one macOS ships) never matches the pattern and never runs
# either body: the expect just burns its whole timeout and falls through, so
# the test passes vacuously while asserting nothing.  This file was written
# that way and was silently checking nothing at all; keep the patterns on
# their own lines.
#
# Patterns are ASCII on purpose too: the status line's mode diamonds and the
# em dash in "plan mode - read-only" are multibyte, and what expect sees on a
# pty depends on the channel encoding.  Anchor on the ASCII around them.
set timeout 120

set repo [file dirname [file dirname [file normalize $argv0]]]
set scratch [exec mktemp -d /tmp/evo-plan.XXXXXX]
set env(EVO_HOME) "$scratch/home"
file mkdir $env(EVO_HOME)/extensions
# Backend config comes from the environment (defaults for the local dev proxy).
proc envdef {name default} {
    global env
    return [expr {[info exists env($name)] ? $env($name) : $default}]
}
set base_url [envdef EVO_TEST_BASE_URL ""]
set api_key  [envdef EVO_TEST_API_KEY  ""]
set model    [envdef EVO_TEST_MODEL    ""]
# No backend/key/model is baked into the repo (dev values are in project
# memory, .evo/).  Without full config this live-model test can't run: fail
# hard rather than pass vacuously.
if {$base_url eq "" || $api_key eq "" || $model eq ""} {
    puts stderr "plan-mode.exp: set EVO_TEST_BASE_URL, EVO_TEST_API_KEY and EVO_TEST_MODEL (dev values in project memory)"
    exit 1
}
# Don't inherit a parent supervisor's private env (e.g. when run from inside an
# agent): let the evo under test manage its own lifecycle and heartbeat.
foreach v {EVO_SUPERVISED_CHILD EVO_HEARTBEAT_FILE} {
    if {[info exists env($v)]} { unset env($v) }
}
set f [open "$env(EVO_HOME)/init.lisp" w]
puts $f "(evo:register-model \"$model\" :provider :anthropic :api :anthropic-messages :context-window 1000000 :max-output 64000 :thinking t)"
puts $f "(evo:set-setting :model \"$model\")"
puts $f {(evo:set-setting :thinking :low)}
puts $f "(evo:register-provider :anthropic :base-url \"$base_url\" :api-key \"$api_key\")"
close $f
file mkdir "$scratch/work"
cd "$scratch/work"

set pass 0
set failures {}
proc check {name} {
    global pass
    incr pass
    puts "\nPASS: $name"
}
proc fail {name} {
    global failures
    lappend failures $name
    puts "\nFAIL: $name"
}
# The journal assertions are booleans, not patterns.
proc check-that {ok name} {
    if {$ok} { check $name } else { fail $name }
}

spawn "$repo/build/evo"
expect {
    -re {auto[^\n]*ctx \d+k/\d+k} { check "startup mode indicator" }
    timeout { fail "startup mode indicator"; exit 1 }
}

# One real turn so the journal flushes to disk.
send "Reply with exactly the word: zebra-fig\r"
# The first match is our own echo in the editor; the model's reply is the
# second.  (Matching once would pass without a backend at all.)
expect {
    -re {zebra-fig} {}
    timeout { fail "first turn"; exit 1 }
}
expect {
    -re {zebra-fig} { check "live turn round-trips" }
    timeout { fail "live turn round-trips"; exit 1 }
}
# Let the turn finish so the mode keystroke is not sent into a live stream.
expect {
    -re {idle} {}
    timeout {}
}
sleep 1

# shift+tab (CSI Z) toggles into plan mode; indicator follows
send "\x1b\[Z"
expect {
    -re {plan mode} { check "shift+tab enters plan mode" }
    timeout { fail "shift+tab enters plan mode" }
}
expect {
    -re {plan[^\n]*ctx \d+k/\d+k} { check "plan indicator in the status line" }
    timeout { fail "plan indicator in the status line" }
}
sleep 1
# /permission auto switches back
send "/permission auto\r"
expect {
    -re {auto mode} { check "/permission auto" }
    timeout { fail "/permission auto" }
}
sleep 1
# /permission with no argument opens the choose box; pick plan (second entry)
send "/permission\r"
expect {
    -re {permission:} { check "/permission opens the choose box" }
    timeout { fail "/permission opens the choose box" }
}
send "\x1b\[B"
sleep 0.3
send "\r"
expect {
    -re {plan mode} { check "choose box selects plan" }
    timeout { fail "choose box selects plan" }
}
sleep 1
send "/permission auto\r"
expect {
    -re {auto mode} {}
    timeout {}
}
sleep 1
send "/exit\r"
expect {
    eof { check "clean quit" }
    timeout { fail "clean quit"; catch {close} }
}

set session [exec sh -c "ls -t $env(EVO_HOME)/sessions/*/*.sexp | head -1"]
check-that [expr {![catch {exec grep -q {:key "mode" :data "plan"} $session}]}] "journal records plan state"
check-that [expr {![catch {exec grep -q {:key "mode" :data "auto"} $session}]}] "journal records auto state"
check-that [expr {![catch {exec grep -q {:type :tools-change} $session}]}] "journal records the tool gating"
check-that [expr {![catch {exec grep -q {:key "plan-mode"} $session}]}] "journal records the plan-mode injection"
# Nothing was loaded from an extensions directory: plan mode came from the binary.
check-that [expr {[catch {exec grep -q {:type :load} $session}]}] "plan mode came from the binary"

puts "\n$pass checks passed, [llength $failures] failed ($scratch)"
if {[llength $failures] > 0} { puts "failures: $failures"; exit 1 }
exit 0
